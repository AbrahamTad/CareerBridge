# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Database (from Supabase dashboard -> Settings -> Database) ===
# Use the "Transaction" pooler URL for DATABASE_URL (port 6543)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Use the "Session" pooler or direct URL for DIRECT_URL (port 5432)
DIRECT_URL=postgresql://postgres.xxxxx:password@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# === AI Providers ===
# Optional preferred provider. If empty, CareerBridge uses automatic fallback:
# OpenAI -> DeepSeek -> Groq -> OpenRouter -> AI Sweden -> Hugging Face -> Ollama -> Anthropic
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
AI_SWEDEN_API_KEY=
AI_SWEDEN_MODEL=AI-Sweden-Models/gpt-sw3-6.7b-v2-instruct
HUGGINGFACE_API_KEY=
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=intfloat/multilingual-e5-large-instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
AI_PROVIDER_TIMEOUT_MS=20000
OLLAMA_TIMEOUT_MS=4000

# === App ===
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Stripe (optional, for future payments) ===
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
