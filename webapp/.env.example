# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase dashboard -> Settings -> Database)
# DATABASE_URL = Supabase transaction/session pooler URL for app traffic.
# Use port 6543 for transaction pooling and keep pgbouncer=true for Prisma.
# DIRECT_URL = Supabase direct database URL for migrations when available.
# Use port 5432, SSL required, and never commit real credentials.
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require"

# AI provider fallback order:
# Gemini -> OpenAI -> DeepSeek -> Groq -> OpenRouter -> Anthropic -> Hugging Face -> AI Sweden -> Ollama
AI_PROVIDER=
AI_PROVIDER_TIMEOUT_MS=20000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

HUGGINGFACE_API_KEY=
# Standard Hugging Face token alias. Use either this or HUGGINGFACE_API_KEY.
HF_TOKEN=
# Legacy CareerBridge alias kept for backward compatibility.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=openai/gpt-oss-120b:cerebras

# Use a dedicated GPT-SW3 endpoint or the Hugging Face router fallback.
AI_SWEDEN_API_KEY=
AI_SWEDEN_PROVIDER=huggingface
AI_SWEDEN_MODEL=AI-Sweden-Models/gpt-sw3-356m
AI_SWEDEN_BASE_URL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_MS=4000

# Legacy AI Sweden / GPT-SW3 aliases kept for backward compatibility.
GPT_SW3_MODEL=
GPT_SW3_ENDPOINT=

# Swedish public APIs and career-page search catalogs
ARBETSFORMEDLINGEN_JOBSEARCH_BASE_URL=https://jobsearch.api.jobtechdev.se
JOBTECH_TAXONOMY_BASE_URL=https://taxonomy.api.jobtechdev.se
JOB_SOURCE_TIMEOUT_MS=10000
JOB_SOURCE_RETRY_COUNT=1

ENABLE_ARBETSFORMEDLINGEN=true
ENABLE_JOBTECH_TAXONOMY=true
ENABLE_KOMMUN_JOBS=true
ENABLE_REGION_JOBS=true
ENABLE_COMPANY_CAREER_PAGES=true
ENABLE_LIA_PRAKTIK_SEARCH=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEV_AI_CALLS_LIMIT=500
DISABLE_AI_USAGE_LIMITS=false

# Stripe (optional; only billing routes need these)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
