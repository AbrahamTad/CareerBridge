# CareerBridge / career-ops environment variables
# Copy to .env for root CLI tools, and copy webapp/.env.example to webapp/.env.local for the Next.js app.

# Database (optional for root CLI tools; required for the webapp)
# DATABASE_URL = Supabase transaction/session pooler URL for app traffic.
# DIRECT_URL = Supabase direct database URL for migrations when available.
# Use SSL required and never commit real credentials.
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require"

# AI provider fallback order:
# Gemini -> OpenAI -> DeepSeek -> Groq -> OpenRouter -> Anthropic -> Hugging Face -> AI Sweden -> Ollama
AI_PROVIDER=
AI_PROVIDER_TIMEOUT_MS=20000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

HUGGINGFACE_API_KEY=
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=

AI_SWEDEN_API_KEY=
AI_SWEDEN_MODEL=
AI_SWEDEN_BASE_URL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_MS=4000

# Legacy AI Sweden / GPT-SW3 aliases kept for backward compatibility.
GPT_SW3_MODEL=
GPT_SW3_ENDPOINT=
